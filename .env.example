# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/eduone-workspace
# ---- Auth (openssl rand -base64 32) ----
AUTH_SECRET=replace-with-a-long-random-string
# ---- Company domain: members get name@this-domain ----
WORKSPACE_DOMAIN=eduoneinternational.com
# ---- File storage on your VPS (outside the app and public folders) ----
STORAGE_DIR=/var/lib/eduone-workspace
QUOTA_BYTES=150000000000
# ---- Meet (free public Jitsi; change to your own Jitsi host later) ----
MEET_HOST=meet.jit.si
# ---- First admin: created by `npm run seed` as <local>@WORKSPACE_DOMAIN ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_LOCAL=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
